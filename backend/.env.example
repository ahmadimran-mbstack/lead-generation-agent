# Exa AI Search API Key
EXA_API_KEY=your_exa_api_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Connection String
POSTGRES_URI=postgresql://user:password@localhost:5432/dbname

# API Bearer Access Token for protecting endpoints
# Generate a secure token using: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_ACCESS_TOKEN=your_api_access_token_here

# LangSmith settings
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT="prospex-lead-generation"

# HubSpot service key
HUBSPOT_SERVICE_KEY=your_hubspot_service_key_here

FRONTEND_LIVE_URL=your_live_deployed_frontend_url
