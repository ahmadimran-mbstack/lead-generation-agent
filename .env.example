# --- Backend Environment Variables ---
# Exa AI Search API Key
EXA_API_KEY=your_exa_api_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# PostgreSQL Connection String
POSTGRES_URI=postgresql://user:password@localhost:5432/dbname

# API Bearer Access Token for protecting endpoints
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_ACCESS_TOKEN=your_api_access_token_here

# LangSmith settings
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT="prospex-lead-generation"

# HubSpot service key
HUBSPOT_SERVICE_KEY=your_hubspot_service_key_here

# --- Frontend Environment Variables (Server-Only, No NEXT_PUBLIC_) ---
# Backend API URL used by Next.js server routes
BACKEND_API_URL=http://localhost:8000

# Backend API Access Token (Authorization: Bearer <API_ACCESS_TOKEN>)
API_ACCESS_TOKEN=your_backend_api_access_token_here

# Admin Login Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password_here

# Session Secret (random string, at least 32 characters, used to sign session JWT)
SESSION_SECRET=your_random_session_secret_at_least_32_characters_long
